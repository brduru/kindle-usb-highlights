{
	"name": "obsidian-kindle-usb",
	"version": "0.1.1",
	"description": "Importa destaques e notas do Kindle via USB (My Clippings.txt) para o Obsidian",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node --test \"test/**/*.test.ts\"",
		"typecheck": "tsc -noEmit",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^24.19.2",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.5.1",
		"globals": "^17.14.0",
		"jiti": "^2.7.0",
		"obsidian": "1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1"
	},
	"overrides": {
		"minimatch@>=7.0.0 <11.0.1": "^11.0.5"
	}
}
